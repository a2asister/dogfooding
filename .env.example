# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=notes_user
DB_PASSWORD=notes_password
DB_NAME=daily_notes
DB_ROOT_PASSWORD=rootpassword

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# 加密配置
ENCRYPTION_KEY=your_32_char_encryption_key_here

# 应用端口
BACKEND_PORT=3001
FRONTEND_PORT=3000

# 环境
NODE_ENV=development
