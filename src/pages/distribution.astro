---
import Layout from '../layouts/Layout.astro';
---

<Layout title="流量分发 - 内容生态系统">
  <div class="distribution-container">
    <h1>流量分发中心</h1>
    <p class="description">智能流量分配，爆款加温，长尾盘活，低质限流</p>
    
    <div class="distribution-overview">
      <div class="metric-card">
        <span class="metric-icon">📊</span>
        <span class="metric-value" id="totalTraffic">0</span>
        <span class="metric-label">今日总流量</span>
      </div>
      <div class="metric-card">
        <span class="metric-icon">🔥</span>
        <span class="metric-value" id="hotContent">0</span>
        <span class="metric-label">爆款内容</span>
      </div>
      <div class="metric-card">
        <span class="metric-icon">📈</span>
        <span class="metric-value" id="longTail">0</span>
        <span class="metric-label">长尾内容</span>
      </div>
      <div class="metric-card">
        <span class="metric-icon">🚫</span>
        <span class="metric-value" id="lowQuality">0</span>
        <span class="metric-label">已限流内容</span>
      </div>
    </div>
    
    <div class="tabs">
      <button class="tab-btn active" data-tab="quality">质量分级</button>
      <button class="tab-btn" data-tab="weight">流量权重</button>
      <button class="tab-btn" data-tab="rules">规则优化</button>
    </div>
    
    <div id="tabContent">
      <div class="tab-panel active" id="qualityPanel">
        <h2>内容质量分级</h2>
        <div class="quality-legend">
          <div class="legend-item high">
            <span class="legend-dot"></span>
            <span>S级 (爆款) - 高互动率，高质量</span>
          </div>
          <div class="legend-item medium">
            <span class="legend-dot"></span>
            <span>A级 (优质) - 良好表现，稳定流量</span>
          </div>
          <div class="legend-item normal">
            <span class="legend-dot"></span>
            <span>B级 (普通) - 基础流量保障</span>
          </div>
          <div class="legend-item low">
            <span class="legend-dot"></span>
            <span>C级 (低质) - 流量限制</span>
          </div>
        </div>
        <div id="qualityList" class="content-list">
          <p class="loading">加载中...</p>
        </div>
      </div>
      
      <div class="tab-panel" id="weightPanel">
        <h2>流量权重分配</h2>
        <p class="panel-desc">根据内容质量、互动数据、发布时间动态调整流量权重</p>
        <div id="weightList" class="weight-list">
          <p class="loading">加载中...</p>
        </div>
      </div>
      
      <div class="tab-panel" id="rulesPanel">
        <h2>流量规则优化</h2>
        <p class="panel-desc">基于数据复盘，持续优化流量分配规则</p>
        
        <div class="rules-section">
          <h3>当前规则配置</h3>
          <div class="rules-grid" id="rulesGrid">
            <p class="loading">加载中...</p>
          </div>
        </div>
        
        <div class="optimization-section">
          <h3>优化建议</h3>
          <div id="optimizationTips" class="tips-list">
            <p class="loading">加载中...</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const gradeLabels: Record<string, string> = {
      S: 'S级 (爆款)',
      A: 'A级 (优质)',
      B: 'B级 (普通)',
      C: 'C级 (低质)'
    };

    const gradeColors: Record<string, string> = {
      S: 'grade-s',
      A: 'grade-a',
      B: 'grade-b',
      C: 'grade-c'
    };

    const categoryLabels: Record<string, string> = {
      tech: '科技',
      lifestyle: '生活方式',
      education: '教育',
      entertainment: '娱乐',
      business: '商业'
    };

    async function loadOverview() {
      try {
        const response = await fetch('/api/distribution/overview');
        const result = await response.json();
        if (!response.ok) throw new Error(result.error);
        
        document.getElementById('totalTraffic')!.textContent = result.data.totalTraffic.toLocaleString();
        document.getElementById('hotContent')!.textContent = result.data.hotCount;
        document.getElementById('longTail')!.textContent = result.data.longTailCount;
        document.getElementById('lowQuality')!.textContent = result.data.restrictedCount;
      } catch (error) {
        console.error('加载概览失败:', error);
      }
    }

    async function loadQualityList() {
      const listDiv = document.getElementById('qualityList');
      try {
        const response = await fetch('/api/distribution/quality');
        const result = await response.json();
        if (!response.ok) throw new Error(result.error);
        
        const contents = result.data.contents;
        if (contents.length === 0) {
          listDiv!.innerHTML = '<p class="empty">暂无内容</p>';
          return;
        }
        
        listDiv!.innerHTML = contents.map((item: any) => `
          <div class="quality-card">
            <div class="quality-header">
              <h3>${item.title}</h3>
              <span class="grade-badge ${gradeColors[item.qualityGrade]}">${gradeLabels[item.qualityGrade]}</span>
            </div>
            <div class="quality-meta">
              <span>作者: ${item.author}</span>
              <span>分类: ${categoryLabels[item.category] || item.category}</span>
            </div>
            <div class="quality-stats">
              <div class="stat">
                <span class="stat-num">${item.views || 0}</span>
                <span class="stat-text">浏览</span>
              </div>
              <div class="stat">
                <span class="stat-num">${item.likes || 0}</span>
                <span class="stat-text">点赞</span>
              </div>
              <div class="stat">
                <span class="stat-num">${item.comments || 0}</span>
                <span class="stat-text">评论</span>
              </div>
              <div class="stat">
                <span class="stat-num">${item.shares || 0}</span>
                <span class="stat-text">分享</span>
              </div>
              <div class="stat">
                <span class="stat-num">${((item.engagementRate || 0) * 100).toFixed(1)}%</span>
                <span class="stat-text">互动率</span>
              </div>
            </div>
          </div>
        `).join('');
      } catch (error) {
        listDiv!.innerHTML = `<p class="error">加载失败: ${error.message}</p>`;
      }
    }

    async function loadWeightList() {
      const listDiv = document.getElementById('weightList');
      try {
        const response = await fetch('/api/distribution/weights');
        const result = await response.json();
        if (!response.ok) throw new Error(result.error);
        
        const weights = result.data.weights;
        if (weights.length === 0) {
          listDiv!.innerHTML = '<p class="empty">暂无数据</p>';
          return;
        }
        
        listDiv!.innerHTML = weights.map((item: any) => `
          <div class="weight-item">
            <div class="weight-header">
              <h3>${item.title}</h3>
              <span class="weight-score">权重: ${item.weight.toFixed(2)}</span>
            </div>
            <div class="weight-bar-container">
              <div class="weight-bar" style="width: ${Math.min(item.weight * 20, 100)}%; background: ${item.weight >= 4 ? '#ef4444' : item.weight >= 2 ? '#f59e0b' : '#10b981'};"></div>
            </div>
            <div class="weight-factors">
              <div class="factor">
                <span class="factor-label">质量分</span>
                <span class="factor-value">${item.qualityScore.toFixed(1)}</span>
              </div>
              <div class="factor">
                <span class="factor-label">热度分</span>
                <span class="factor-value">${item.trendingScore.toFixed(1)}</span>
              </div>
              <div class="factor">
                <span class="factor-label">作者分</span>
                <span class="factor-value">${item.authorScore.toFixed(1)}</span>
              </div>
              <div class="factor">
                <span class="factor-label">时效分</span>
                <span class="factor-value">${item.recencyScore.toFixed(1)}</span>
              </div>
            </div>
          </div>
        `).join('');
      } catch (error) {
        listDiv!.innerHTML = `<p class="error">加载失败: ${error.message}</p>`;
      }
    }

    async function loadRules() {
      const rulesDiv = document.getElementById('rulesGrid');
      const tipsDiv = document.getElementById('optimizationTips');
      
      try {
        const response = await fetch('/api/distribution/rules');
        const result = await response.json();
        if (!response.ok) throw new Error(result.error);
        
        // 加载规则
        const rules = result.data.rules;
        rulesDiv!.innerHTML = rules.map((rule: any) => `
          <div class="rule-card">
            <div class="rule-name">${rule.name}</div>
            <div class="rule-value">${rule.value}</div>
            <div class="rule-desc">${rule.description}</div>
          </div>
        `).join('');
        
        // 加载优化建议
        const tips = result.data.tips;
        tipsDiv!.innerHTML = tips.map((tip: any) => `
          <div class="tip-card">
            <span class="tip-icon">${tip.impact === 'high' ? '🔥' : tip.impact === 'medium' ? '⚡' : '💡'}</span>
            <div class="tip-content">
              <h4>${tip.title}</h4>
              <p>${tip.description}</p>
              <span class="tip-impact">影响度: ${tip.impact === 'high' ? '高' : tip.impact === 'medium' ? '中' : '低'}</span>
            </div>
          </div>
        `).join('');
        
      } catch (error) {
        rulesDiv!.innerHTML = `<p class="error">加载失败: ${error.message}</p>`;
        tipsDiv!.innerHTML = `<p class="error">加载失败: ${error.message}</p>`;
      }
    }

    // Tab 切换
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        
        btn.classList.add('active');
        const tabId = btn.getAttribute('data-tab');
        
        if (tabId === 'quality') {
          document.getElementById('qualityPanel')!.classList.add('active');
          loadQualityList();
        } else if (tabId === 'weight') {
          document.getElementById('weightPanel')!.classList.add('active');
          loadWeightList();
        } else if (tabId === 'rules') {
          document.getElementById('rulesPanel')!.classList.add('active');
          loadRules();
        }
      });
    });

    // 初始化
    loadOverview();
    loadQualityList();
  </script>

  <style is:global>
    .distribution-container {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 2rem;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    h1 { color: #333; margin-bottom: 0.5rem; }
    .description { color: #666; margin-bottom: 2rem; }
    
    .distribution-overview {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .metric-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 1.5rem;
      border-radius: 12px;
      text-align: center;
      color: white;
    }
    .metric-icon { font-size: 2rem; display: block; margin-bottom: 0.5rem; }
    .metric-value { font-size: 2rem; font-weight: 700; display: block; }
    .metric-label { font-size: 0.875rem; opacity: 0.9; }
    
    .tabs {
      display: flex;
      gap: 0.5rem;
      border-bottom: 2px solid #e5e7eb;
      margin-bottom: 2rem;
    }
    .tab-btn {
      padding: 1rem 2rem;
      background: none;
      border: none;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      color: #666;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
    }
    .tab-btn.active {
      color: #4f46e5;
      border-bottom-color: #4f46e5;
    }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    
    .panel-desc { color: #666; margin-bottom: 1.5rem; }
    
    .quality-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: #f8fafc;
      border-radius: 8px;
    }
    .legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; }
    .legend-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #e5e7eb;
    }
    .legend-item.high .legend-dot { background: #ef4444; }
    .legend-item.medium .legend-dot { background: #f59e0b; }
    .legend-item.normal .legend-dot { background: #10b981; }
    .legend-item.low .legend-dot { background: #6b7280; }
    
    .content-list { display: flex; flex-direction: column; gap: 1rem; }
    .loading, .empty, .error { text-align: center; padding: 2rem; color: #666; }
    
    .quality-card {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 1.5rem;
    }
    .quality-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
    }
    .quality-header h3 { margin: 0; color: #333; font-size: 1.1rem; }
    .grade-badge {
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .grade-s { background: #fee2e2; color: #991b1b; }
    .grade-a { background: #fef3c7; color: #92400e; }
    .grade-b { background: #d1fae5; color: #065f46; }
    .grade-c { background: #f1f5f9; color: #475569; }
    
    .quality-meta {
      display: flex;
      gap: 1.5rem;
      color: #666;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
    .quality-stats {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
      padding-top: 1rem;
      border-top: 1px solid #e5e7eb;
    }
    .quality-stats .stat { text-align: center; }
    .stat-num { display: block; font-size: 1.25rem; font-weight: 600; color: #333; }
    .stat-text { display: block; font-size: 0.75rem; color: #666; }
    
    .weight-list { display: flex; flex-direction: column; gap: 1rem; }
    .weight-item {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 1.5rem;
    }
    .weight-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .weight-header h3 { margin: 0; color: #333; font-size: 1.1rem; }
    .weight-score {
      font-weight: 600;
      color: #4f46e5;
      font-size: 1.1rem;
    }
    .weight-bar-container {
      height: 8px;
      background: #e5e7eb;
      border-radius: 4px;
      margin-bottom: 1rem;
      overflow: hidden;
    }
    .weight-bar { height: 100%; border-radius: 4px; transition: width 0.3s; }
    .weight-factors {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .factor {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.5rem;
      background: #f8fafc;
      border-radius: 8px;
    }
    .factor-label { font-size: 0.75rem; color: #666; }
    .factor-value { font-weight: 600; color: #333; }
    
    .rules-section, .optimization-section { margin-bottom: 2rem; }
    .rules-section h3, .optimization-section h3 { margin-bottom: 1rem; color: #333; }
    .rules-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
    .rule-card {
      background: #f8fafc;
      padding: 1rem;
      border-radius: 8px;
      border-left: 4px solid #4f46e5;
    }
    .rule-name { font-weight: 600; color: #333; margin-bottom: 0.25rem; }
    .rule-value { color: #4f46e5; font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem; }
    .rule-desc { font-size: 0.75rem; color: #666; }
    
    .tips-list { display: flex; flex-direction: column; gap: 1rem; }
    .tip-card {
      display: flex;
      gap: 1rem;
      padding: 1rem;
      background: #f8fafc;
      border-radius: 8px;
      align-items: flex-start;
    }
    .tip-icon { font-size: 1.5rem; }
    .tip-content { flex: 1; }
    .tip-content h4 { margin: 0 0 0.25rem 0; color: #333; }
    .tip-content p { margin: 0 0 0.25rem 0; color: #666; font-size: 0.875rem; }
    .tip-impact {
      font-size: 0.75rem;
      color: #4f46e5;
      font-weight: 500;
    }
  </style>
</Layout>
