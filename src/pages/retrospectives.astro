---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-graph-up me-2"></i>迭代复盘</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRetroModal">
      <i class="bi bi-plus-circle me-1"></i>新增复盘
    </button>
  </div>

  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card card-custom p-4">
        <h5 class="mb-3">迭代完成率趋势</h5>
        <canvas id="completionChart" height="200"></canvas>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card card-custom p-4">
        <h5 class="mb-3">缺陷率趋势</h5>
        <canvas id="bugRateChart" height="200"></canvas>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card card-custom p-4 text-center">
        <i class="bi bi-speedometer display-4 text-primary mb-2"></i>
        <h6 class="text-muted">平均迭代速度</h6>
        <h3 id="avg-velocity">--</h3>
        <p class="small text-muted">故事点/迭代</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card card-custom p-4 text-center">
        <i class="bi bi-check-circle display-4 text-success mb-2"></i>
        <h6 class="text-muted">平均完成率</h6>
        <h3 id="avg-completion">--</h3>
        <p class="small text-muted">%</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card card-custom p-4 text-center">
        <i class="bi bi-bug display-4 text-danger mb-2"></i>
        <h6 class="text-muted">平均缺陷率</h6>
        <h3 id="avg-bug-rate">--</h3>
        <p class="small text-muted">%</p>
      </div>
    </div>
  </div>

  <div class="card card-custom">
    <div class="card-body">
      <h5 class="card-title">复盘历史</h5>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>迭代</th>
              <th>完成率</th>
              <th>缺陷率</th>
              <th>迭代速度</th>
              <th>做得好的</th>
              <th>需要改进的</th>
              <th>创建时间</th>
            </tr>
          </thead>
          <tbody id="retrospectives-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal fade" id="addRetroModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">新增迭代复盘</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="addRetroForm">
            <div class="mb-3">
              <label class="form-label">关联迭代 *</label>
              <select class="form-select" id="retro-iteration" required></select>
            </div>
            <div class="row">
              <div class="col-md-4">
                <label class="form-label">迭代完成率 (%)</label>
                <input type="number" class="form-control" id="retro-completion" min="0" max="100">
              </div>
              <div class="col-md-4">
                <label class="form-label">缺陷率 (%)</label>
                <input type="number" class="form-control" id="retro-bug-rate" min="0" max="100" step="0.1">
              </div>
              <div class="col-md-4">
                <label class="form-label">迭代速度 (故事点)</label>
                <input type="number" class="form-control" id="retro-velocity">
              </div>
            </div>
            <div class="mb-3 mt-3">
              <label class="form-label">做得好的方面</label>
              <textarea class="form-control" id="retro-went-well" rows="3"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">需要改进的方面</label>
              <textarea class="form-control" id="retro-improvements" rows="3"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">行动项</label>
              <textarea class="form-control" id="retro-actions" rows="3"></textarea>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
          <button type="button" class="btn btn-primary" onclick="addRetrospective()">保存</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let retrospectives = [];
    let iterations = [];

    async function loadRetrospectives() {
      try {
        const [retros, iters] = await Promise.all([
          fetch('/api/retrospectives').then(r => r.json()),
          fetch('/api/iterations').then(r => r.json())
        ]);
        retrospectives = retros;
        iterations = iters;
        
        const iterSelect = document.getElementById('retro-iteration');
        iterSelect.innerHTML = iters.map(i => `<option value="${i.id}">${i.name} (${i.version})</option>`).join('');
        
        renderRetrospectivesTable();
        renderCharts();
        updateStats();
      } catch (error) {
        console.error('加载复盘失败:', error);
      }
    }

    function renderRetrospectivesTable() {
      const tableBody = document.getElementById('retrospectives-table');
      tableBody.innerHTML = retrospectives.map(retro => {
        const iter = iterations.find(i => i.id === retro.iteration_id);
        return `
          <tr>
            <td><strong>${iter ? iter.name : '-'}</strong></td>
            <td>
              <div class="progress" style="height: 8px; width: 80px; display: inline-block;">
                <div class="progress-bar bg-success" style="width: ${retro.completion_rate}%;"></div>
              </div>
              <small class="ms-2">${retro.completion_rate}%</small>
            </td>
            <td><span class="badge ${retro.bug_rate > 20 ? 'bg-danger' : retro.bug_rate > 10 ? 'bg-warning' : 'bg-success'}">${retro.bug_rate}%</span></td>
            <td>${retro.velocity}</td>
            <td class="text-truncate" style="max-width: 200px;" title="${retro.went_well}">${retro.went_well || '-'}</td>
            <td class="text-truncate" style="max-width: 200px;" title="${retro.improvements}">${retro.improvements || '-'}</td>
            <td>${retro.created_at}</td>
          </tr>
        `;
      }).join('');
    }

    function renderCharts() {
      if (retrospectives.length === 0) return;

      const labels = retrospectives.map(retro => {
        const iter = iterations.find(i => i.id === retro.iteration_id);
        return iter ? iter.name : '未知';
      }).reverse();
      
      const completionData = retrospectives.map(r => r.completion_rate).reverse();
      const bugRateData = retrospectives.map(r => r.bug_rate).reverse();

      new Chart(document.getElementById('completionChart'), {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: '完成率 (%)',
            data: completionData,
            borderColor: '#28a745',
            backgroundColor: 'rgba(40, 167, 69, 0.1)',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, max: 100 } }
        }
      });

      new Chart(document.getElementById('bugRateChart'), {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: '缺陷率 (%)',
            data: bugRateData,
            borderColor: '#dc3545',
            backgroundColor: 'rgba(220, 53, 69, 0.1)',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, max: 100 } }
        }
      });
    }

    function updateStats() {
      if (retrospectives.length === 0) {
        document.getElementById('avg-velocity').textContent = '--';
        document.getElementById('avg-completion').textContent = '--';
        document.getElementById('avg-bug-rate').textContent = '--';
        return;
      }

      const avgVelocity = Math.round(retrospectives.reduce((sum, r) => sum + r.velocity, 0) / retrospectives.length);
      const avgCompletion = Math.round(retrospectives.reduce((sum, r) => sum + r.completion_rate, 0) / retrospectives.length);
      const avgBugRate = (retrospectives.reduce((sum, r) => sum + r.bug_rate, 0) / retrospectives.length).toFixed(1);

      document.getElementById('avg-velocity').textContent = avgVelocity;
      document.getElementById('avg-completion').textContent = avgCompletion + '%';
      document.getElementById('avg-bug-rate').textContent = avgBugRate + '%';
    }

    async function addRetrospective() {
      const data = {
        iteration_id: document.getElementById('retro-iteration').value,
        went_well: document.getElementById('retro-went-well').value,
        improvements: document.getElementById('retro-improvements').value,
        action_items: document.getElementById('retro-actions').value,
        velocity: parseInt(document.getElementById('retro-velocity').value) || 0,
        bug_rate: parseFloat(document.getElementById('retro-bug-rate').value) || 0,
        completion_rate: parseInt(document.getElementById('retro-completion').value) || 0
      };

      await fetch('/api/retrospectives', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      bootstrap.Modal.getInstance(document.getElementById('addRetroModal')).hide();
      loadRetrospectives();
    }

    loadRetrospectives();
  </script>
</Layout>
