---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Luxe Gallery - Premium Product Showcase',
  description = 'Experience our exclusive collection of luxury products'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline define:vars={{}}>
      (function() {
        try {
          localStorage.getItem('theme');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
