    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.10",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "sass": "^1.69.7",
