{
  "name": "web-cli-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "tap tests/**/*.test.ts --node-arg=--require=ts-node/register",
    "test:unit": "tap tests/unit.test.ts --node-arg=--require=ts-node/register",
    "test:integration": "tap tests/integration.test.ts --node-arg=--require=ts-node/register",
    "test:coverage": "tap tests/**/*.test.ts --node-arg=--require=ts-node/register --coverage-report=html"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.4.0",
    "fastify": "^4.26.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tap": "^21.7.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
