{
  "name": "notification-center-server",
  "version": "1.0.0",
  "description": "Notification Center Backend",
  "private": true,
  "egg": {
    "declarations": true
  },
  "dependencies": {
    "egg": "^3.17.5",
    "egg-scripts": "2",
    "better-sqlite3": "^11.3.0",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "egg-cors": "^3.0.0"
  },
  "devDependencies": {
    "egg-bin": "6",
    "egg-mock": "5",
    "eslint": "8",
    "eslint-config-egg": "13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "egg-scripts start --daemon --title=egg-server-notification-center",
    "stop": "egg-scripts stop --title=egg-server-notification-center",
    "dev": "egg-bin dev",
    "debug": "egg-bin debug",
    "test": "npm run lint -- --fix && npm run test-local",
    "test-local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint .",
    "ci": "npm run lint && npm run cov"
  },
  "author": "",
  "license": "MIT"
}
