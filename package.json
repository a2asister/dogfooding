{
  "name": "game-official-website",
  "version": "1.0.0",
  "description": "游戏官方公测预约落地页面 - React+Koa 同构架构",
  "main": "server/index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "webpack serve --config webpack.client.dev.js --mode development",
    "dev:server": "nodemon --watch server --exec 'node -r @babel/register server/index.js'",
    "build": "npm run build:client && npm run build:server",
    "build:client": "webpack --config webpack.client.prod.js --mode production",
    "build:server": "webpack --config webpack.server.js --mode production",
    "start": "node dist/server.js",
    "lint": "eslint src server --ext .js,.jsx,.ts,.tsx",
    "test": "jest"
  },
  "keywords": [
    "react",
    "koa",
    "ssr",
    "isomorphic",
    "game-website"
  ],
  "author": "Game Team",
  "license": "MIT",
  "dependencies": {
    "@koa/router": "^12.0.0",
    "axios": "^1.6.0",
    "koa": "^2.14.0",
    "koa-bodyparser": "^4.4.0",
    "koa-compress": "^5.1.0",
    "koa-cors": "^0.0.16",
    "koa-static": "^5.0.0",
    "mysql2": "^3.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.18.0",
    "sequelize": "^6.35.0",
    "express-rate-limit": "^7.1.0",
    "koa-ratelimit": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/node": "^7.22.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/register": "^7.22.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.7.0",
    "nodemon": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "style-loader": "^3.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "webpack-node-externals": "^3.0.0"
  }
}
