{
  "name": "micro-frontend-marketplace",
  "version": "1.0.0",
  "description": "前端微前端应用市场",
  "private": true,
  "scripts": {
    "start": "npm run start:main",
    "start:main": "cd packages/main && npm run dev",
    "start:app1": "cd packages/app1 && npm run dev",
    "build:shared": "cd packages/shared && npm run build",
    "install:all": "npm install && cd packages/shared && npm install && cd ../main && npm install && cd ../app1 && npm install"
  }
}
