{
  "name": "developer-community",
  "version": "1.0.0",
  "description": "开发者共建社区平台",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "start": "npm --prefix server run start",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --prefix server run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
